# Sharsheret HaMesirah — Environment Variables
# Copy to .env and fill in values

# Database (DigitalOcean Managed PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/sharsheret?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Admin credentials (for seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# Sefaria API (no auth needed, public API)
SEFARIA_API_BASE="https://www.sefaria.org/api"

# App
NEXT_PUBLIC_APP_NAME="שרשרת המסירה"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
